# Copia este archivo como .env y completa tus llaves (el .env no se sube)
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-001

# Avisos (P3): canal principal "zavu" o "telegram"; si falla, se usa el otro
AVISO=zavu
# zv_test_... (sandbox: solo WhatsApp a teléfonos del equipo) o zv_live_...
ZAVUDEV_API_KEY=
# whatsapp | sms | vacío = Zavu elige el canal
ZAVU_CANAL=whatsapp
# Celular que recibe el "gracias" en la demo
NUMERO_DEMO=+569XXXXXXXX
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
