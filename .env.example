# Solo para `npm run probar-ia` en local.
# En producción estas variables van como secretos de la Edge Function:
# Supabase → Edge Functions → Secrets
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-medium-2604
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-001
# Voz (Mistral Voxtral TTS, usa MISTRAL_API_KEY). Crear una voz propia: npm run crear-voz -- audio.wav "Nombre"
MISTRAL_VOICE_ID=
MISTRAL_TTS_MODEL=voxtral-mini-tts-2603
# El "gracias" al autor (P3): WhatsApp por Zavu; Telegram solo de respaldo
ZAVUDEV_API_KEY=
NUMERO_DEMO=+569XXXXXXXX
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
# Modo demo: 1 = avisar en cada "¡Aprendí!" (no solo en hitos)
AVISAR_SIEMPRE=
# Cursos por WhatsApp (Zavu → /webhooks/zavu). Sin secreto = modo demo (acepta todo)
ZAVU_WEBHOOK_SECRET=
# Link que se manda por WhatsApp: https://TU-URL (túnel de cloudflared)
URL_PUBLICA=
# Para guardar esos cursos en Supabase (si falta, quedan en data/guias.json)
SUPABASE_SERVICE_ROLE_KEY=
